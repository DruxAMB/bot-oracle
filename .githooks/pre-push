#!/bin/sh
# Block wip: commits from landing on main
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac  # branch deletion, nothing to check
  case "$remote_sha" in *[!0]*) range="$remote_sha..$local_sha" ;; *) range="$local_sha" ;; esac
  if git log --format=%s "$range" | grep -qi '^wip:'; then
    echo "pre-push: 'wip:' commits must not land on main" >&2
    exit 1
  fi
done
